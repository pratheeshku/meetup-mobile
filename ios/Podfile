# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

$RNFirebaseDisableSPM = true

use_modular_headers!

target 'MeetupMobile' do
  config = use_native_modules!

  # AppCheckCore (a Swift pod pulled in by Firebase) needs module maps from
  # these two pods. Add further pods here only when `pod install` names them.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 (iOS 27 SDK) rejects deployment targets below 15.0 ("range of supported
    # deployment target versions is 15.0 to ..."), and many third-party pods still declare
    # 9.0-12.0. Raise any pod target (and the Pods project itself) below 15.0 to 15.0; never
    # lower one that is already higher. The app targets 15.1, so this changes nothing at runtime.
    min_pod_deployment_target = Gem::Version.new('15.0')
    raise_deployment_target = lambda do |build_configurations|
      build_configurations.each do |build_configuration|
        current = build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        next if current.nil? || current.to_s.strip.empty? || current.to_s.include?('$')

        if Gem::Version.new(current.to_s) < min_pod_deployment_target
          build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
    end
    raise_deployment_target.call(installer.pods_project.build_configurations)
    installer.pods_project.targets.each do |target|
      raise_deployment_target.call(target.build_configurations)
    end

    # React-Core-prebuilt ships a Debug and a Release flavor and swaps between them per build
    # configuration (its "[RNCore] Replace React Native Core" script phase). The Debug flavor is
    # built with REACT_NATIVE_DEBUG, which changes the layout of Props, Sealable and
    # DebugStringConvertible (sizeof(Props) is 40 with REACT_NATIVE_DEBUG, 32 with
    # REACT_NATIVE_PRODUCTION). Pod code must therefore see the same macro as the flavor it links:
    # Debug pods keep React Native's default (REACT_NATIVE_DEBUG, derived from the absence of
    # NDEBUG), and only non-Debug configurations get REACT_NATIVE_PRODUCTION=1. Defining it in Debug
    # compiled pods with the 32-byte layout against the 40-byte binary and crashed at launch in
    # Props::Props() (RNCSafeAreaProviderProps). Release configurations are unchanged.
    rn_prod_flag = ' -DREACT_NATIVE_PRODUCTION=1'

    # Make the installed React-Core-prebuilt deterministic after every `pod install`.
    # Its Xcode "[RNCore] Replace React Native Core" phase picks the Debug or Release flavor per build
    # configuration, but when there is no `.last_build_configuration` marker it ASSUMES the Pods folder
    # already holds the Debug flavor and replaces nothing. A restored CI cache (fallback key
    # `pods-<os>-none-`) can hold the Release flavor with no marker; `pod install` keeps it, and a Debug
    # build then fails to link ("Undefined symbols": Sealable::Sealable(), getDebugProps, the
    # DebugStringConvertible vtable ...) because Debug pods need the debug-only symbols that only the Debug
    # flavor exports. So: always install the Debug flavor here and write the marker. The build phase then
    # swaps to Release (and back) from a known state. Skipped when a local RNCore tarball is used.
    unless ENV['RCT_TESTONLY_RNCORE_TARBALL_PATH']
      pods_root = installer.sandbox.root.to_s
      rn_path = File.expand_path(config[:reactNativePath], __dir__)
      rncore_dir = File.join(pods_root, 'React-Core-prebuilt')
      if File.directory?(rncore_dir)
        rn_version = JSON.parse(File.read(File.join(rn_path, 'package.json')))['version']
        marker_file = File.join(rncore_dir, '.last_build_configuration')
        # A non-Debug marker makes replace-rncore-version.js replace unconditionally.
        File.write(marker_file, 'Release')
        replaced = system('node', File.join(rn_path, 'scripts', 'replace-rncore-version.js'),
                          '-c', 'Debug', '-r', rn_version, '-p', pods_root, chdir: pods_root)
        raise 'Podfile: could not install the Debug flavor of React-Core-prebuilt' unless replaced

        Pod::UI.puts "React-Core-prebuilt reset to the Debug flavor (marker: #{File.read(marker_file).strip})"
      end
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, config_file|
        next if aggregate_target.user_build_configurations[config_name] == :debug

        ReactNativePodsUtils.add_flag_to_map_with_inheritance(config_file.attributes, 'OTHER_CPLUSPLUSFLAGS', rn_prod_flag)
        ReactNativePodsUtils.add_flag_to_map_with_inheritance(config_file.attributes, 'OTHER_CFLAGS', rn_prod_flag)
        config_file.save_as(aggregate_target.xcconfig_path(config_name))
      end
    end

    installer.pod_targets.each do |pod_target|
      pod_target.build_settings.each do |config_name, _|
        # build_settings is keyed by the configuration type (:debug / :release).
        next if config_name == :debug

        xcconfig_path = pod_target.xcconfig_path(config_name)
        next unless File.exist?(xcconfig_path)

        xcconfig = Xcodeproj::Config.new(xcconfig_path)
        ReactNativePodsUtils.add_flag_to_map_with_inheritance(xcconfig.attributes, 'OTHER_CPLUSPLUSFLAGS', rn_prod_flag)
        ReactNativePodsUtils.add_flag_to_map_with_inheritance(xcconfig.attributes, 'OTHER_CFLAGS', rn_prod_flag)
        xcconfig.save_as(xcconfig_path)
      end
    end

    installer.target_installation_results.pod_target_installation_results.each do |pod_name, target_installation_result|
      target_installation_result.native_target.build_configurations.each do |cfg|
        next if cfg.type == :debug

        ReactNativePodsUtils.add_flag_to_map_with_inheritance(cfg.build_settings, 'OTHER_CPLUSPLUSFLAGS', rn_prod_flag)
        ReactNativePodsUtils.add_flag_to_map_with_inheritance(cfg.build_settings, 'OTHER_CFLAGS', rn_prod_flag)
      end
    end
  end
end
