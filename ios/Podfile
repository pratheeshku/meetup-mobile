# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

$RNFirebaseDisableSPM = true

use_modular_headers!

target 'MeetupMobile' do
  config = use_native_modules!

  # AppCheckCore (a Swift pod pulled in by Firebase) needs module maps from
  # these two pods. Add further pods here only when `pod install` names them.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    strip_flag = lambda do |val|
      if val.is_a?(Array)
        val.map { |x| strip_flag.call(x) }
      elsif val.is_a?(String)
        val.gsub('-DRCT_NEW_ARCH_ENABLED=1', '').gsub('-DRCT_NEW_ARCH_ENABLED', '').strip
      else
        val
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        ['OTHER_CPLUSPLUSFLAGS', 'OTHER_CFLAGS', 'OTHER_SWIFT_FLAGS'].each do |flag_key|
          if config.build_settings[flag_key]
            config.build_settings[flag_key] = strip_flag.call(config.build_settings[flag_key])
          end
        end
      end
    end
    installer.pods_project.save

    installer.pod_targets.each do |pod_target|
      pod_target.build_settings.each do |config_name, _|
        xcconfig_path = pod_target.xcconfig_path(config_name)
        next unless File.exist?(xcconfig_path)
        xcconfig = Xcodeproj::Config.new(xcconfig_path)
        ['OTHER_CPLUSPLUSFLAGS', 'OTHER_CFLAGS', 'OTHER_SWIFT_FLAGS'].each do |flag_key|
          if xcconfig.attributes[flag_key]
            xcconfig.attributes[flag_key] = strip_flag.call(xcconfig.attributes[flag_key])
          end
        end
        xcconfig.save_as(xcconfig_path)
      end
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, config_file|
        ['OTHER_CPLUSPLUSFLAGS', 'OTHER_CFLAGS', 'OTHER_SWIFT_FLAGS'].each do |flag_key|
          if config_file.attributes[flag_key]
            config_file.attributes[flag_key] = strip_flag.call(config_file.attributes[flag_key])
          end
        end
        config_file.save_as(aggregate_target.xcconfig_path(config_name))
      end
    end
  end
end
