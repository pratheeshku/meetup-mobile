# Optional build-time override. The default API/web host is defined once, in
# config/env.ts (ENV.API_BASE_URL) — leave this unset unless overriding it.
# API_BASE_URL=
# Diagnostics build flag. Set to 'true' to enable the perf layer at build time.
# Runtime toggle: tap display name 7× on Profile screen within 3 s.
PERF_LOG=
# OAuth client IDs below are public identifiers, not secrets.
# Android builds use the web client ID to verify tokens against the backend.
GOOGLE_WEB_CLIENT_ID=716110883386-504n10sm8npuuo2gfeku7epst0j353kl.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=716110883386-r4vaffejschrqg9c5qqo0u0esuds4p4d.apps.googleusercontent.com
